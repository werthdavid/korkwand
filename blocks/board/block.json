{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "korkwand/board",
	"title": "Korkwand",
	"category": "widgets",
	"icon": "sticky",
	"description": "Displays a Korkwand pinboard with notes and images.",
	"textdomain": "korkwand",
	"attributes": {
		"board": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"editorScript": "korkwand-block-editor",
	"style": "korkwand-style",
	"render": "file:./render.php"
}
